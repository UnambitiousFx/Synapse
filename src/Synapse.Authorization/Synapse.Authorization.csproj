<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <Description>Authorization for UnambitiousFx.Synapse: actor, role, scope and resource behaviors driven by request markers, returning UnauthenticatedFailure / UnauthorizedFailure instead of calling the handler.</Description>
        <!-- The behaviors are registered as open generics, closed by the container at runtime. -->
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Synapse.Abstractions\Synapse.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
