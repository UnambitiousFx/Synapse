<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <!-- Endpoints are mapped in this library; the Request Delegate Generator must run here to keep them AOT-safe. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <Description>Endpoint-per-class HTTP layer for UnambitiousFx.Synapse. Maps HTTP requests to CQRS commands and queries with minimal code and full Native AOT support.</Description>
        <PackageTags>aspnetcore;minimal-api;endpoints;cqrs;mediator;native-aot;source-generator</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Synapse.AspNetCore\Synapse.AspNetCore.csproj" />
        <!-- The generator runs against this project's consumers, and ships inside this package. -->
        <ProjectReference Include="..\Synapse.Endpoints.Generator\Synapse.Endpoints.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <Target Name="PackEndpointsAnalyzer" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(MSBuildThisFileDirectory)..\Synapse.Endpoints.Generator\bin\$(Configuration)\netstandard2.0\UnambitiousFx.Synapse.Endpoints.Generator.dll"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs"
                  Visible="false" />
        </ItemGroup>
    </Target>

</Project>
