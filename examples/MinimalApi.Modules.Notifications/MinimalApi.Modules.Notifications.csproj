<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!--
        Intentionally NO Synapse.Generator reference — handlers in this module are registered
        manually via cfg.RegisterEventHandler<THandler, TEvent>() instead of the source generator.
        This is the contrast to MinimalApi.Modules.Orders which uses [EventHandler<T>] + RegisterGroup.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Synapse.AspNetCore\Synapse.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Synapse\Synapse.csproj" />
        <ProjectReference Include="..\MinimalApi.Modules.Contracts\MinimalApi.Modules.Contracts.csproj" />
    </ItemGroup>

</Project>
