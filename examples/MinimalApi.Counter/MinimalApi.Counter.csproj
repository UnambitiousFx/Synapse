<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Endpoints are mapped in this library, so the Request Delegate Generator must run here (it only
             transforms MapGet/MapPost calls in the compilation that declares them) to keep them AOT-safe. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Synapse.AspNetCore\Synapse.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Synapse\Synapse.csproj" />
        <ProjectReference Include="..\..\src\Synapse.Generator\Synapse.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
