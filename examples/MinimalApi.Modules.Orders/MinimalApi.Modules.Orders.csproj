<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Endpoints are mapped in this library; the Request Delegate Generator must run here to keep them AOT-safe. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Synapse.AspNetCore\Synapse.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Synapse\Synapse.csproj" />
        <!-- Source generator: emits RegisterGroup with [RequestHandler<>] closures. -->
        <ProjectReference Include="..\..\src\Synapse.Generator\Synapse.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\MinimalApi.Modules.Contracts\MinimalApi.Modules.Contracts.csproj" />
    </ItemGroup>

</Project>
