### Synapse Feature Showcase — WebApi (Standard ASP.NET Core)
### Run `dotnet run` in examples/WebApi, then execute requests top-to-bottom.
### Each block states which Synapse feature it exercises and what to verify.
@baseUrl = http://localhost:5175

# ═══════════════════════════════════════════════════════════════════════
# 1. API Info
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Root endpoint] List all available features and endpoints
GET {{baseUrl}}/
Accept: application/json

> {%
    client.test("API info returns 200", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.name !== undefined, "name field present");
        client.assert(Array.isArray(response.body.features), "features list present");
        client.assert(Array.isArray(response.body.endpoints), "endpoints list present");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 2. Command with typed response (CreateTask → Guid)
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Command + Validation] Create a valid task
### Expect: 201 Created, Location header, X-Correlation-Id header
### Observe stdout: SimpleLoggingBehavior logs CreateTaskCommand timing
###                 TaskCreatedLoggingHandler logs the event
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Implement Synapse streaming",
  "description": "Add IStreamRequest<T> support to demonstrate the streaming query pattern"
}

> {%
    client.test("Create task returns 201 Created", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });

    client.test("Location header points to new task", function () {
        const location = response.headers.valueOf("Location");
        client.assert(location !== undefined, "Location header present");
        const guidPattern = /\/tasks\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i;
        client.assert(guidPattern.test(location), "Location contains a valid task URL");
        client.global.set("taskId", location.match(guidPattern)[1]);
    });

    client.test("X-Correlation-Id header is present", function () {
        client.assert(response.headers.valueOf("X-Correlation-Id") !== undefined,
            "X-Correlation-Id header present (IContext.CorrelationId)");
    });
%}

###

### [Feature: Validation] Create a task with an empty title — should be rejected
### Expect: failure response (validation error from RequestValidationBehavior)
### Observe stdout: SimpleLoggingBehavior logs the failure
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "",
  "description": "This should fail because title is empty"
}

> {%
    client.test("Empty title is rejected", function () {
        client.assert(response.status !== 201, "Should not create a task with empty title");
        client.assert(response.status >= 400, "Expected an error status code");
    });
%}

###

### [Feature: Validation] Create a task with an empty description — should be rejected
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Valid title",
  "description": ""
}

> {%
    client.test("Empty description is rejected", function () {
        client.assert(response.status >= 400, "Expected an error status code");
    });
%}

###

# Create a second task for the streaming and list tests
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Write unit tests",
  "description": "Cover all handler edge cases with the AAA pattern"
}

> {%
    client.test("Second task created", function () {
        client.assert(response.status === 201, "Expected 201 Created");
        const location = response.headers.valueOf("Location");
        const guidPattern = /\/tasks\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i;
        client.global.set("taskId2", location.match(guidPattern)[1]);
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 3. Query — single item
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Query returning TaskDto] Get a task by ID
### Expect: 200 OK with task body, X-Correlation-Id header
GET {{baseUrl}}/tasks/{{taskId}}
Accept: application/json

> {%
    client.test("Get task returns 200", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.id === client.global.get("taskId"), "ID matches");
        client.assert(response.body.title === "Implement Synapse streaming", "Title matches");
        client.assert(response.body.createdAt !== undefined, "createdAt present");
    });

    client.test("X-Correlation-Id header is present", function () {
        client.assert(response.headers.valueOf("X-Correlation-Id") !== undefined, "Correlation ID set");
    });
%}

###

### [Feature: Query failure] Get a non-existent task
### Expect: failure response (handler returns Result.Failure → IFailureHttpMapper maps it)
GET {{baseUrl}}/tasks/00000000-0000-0000-0000-000000000000
Accept: application/json

> {%
    client.test("Not-found task returns error status", function () {
        client.assert(response.status >= 400, "Expected an error status code");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 4. Query — list
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Query returning List<TaskDto>] List all tasks
### Expect: 200 OK with JSON array of tasks
GET {{baseUrl}}/tasks
Accept: application/json

> {%
    client.test("List tasks returns 200", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(Array.isArray(response.body), "Response is an array");
        client.assert(response.body.length >= 2, "At least 2 tasks present");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 5. Streaming request
# ═══════════════════════════════════════════════════════════════════════

### [Feature: IStreamRequest<T>] Stream all tasks as IAsyncEnumerable
### The handler yields each TaskDto one by one; ASP.NET Core flushes them as a JSON array.
### Observe stdout: SimpleLoggingBehavior logs the StreamTasksQuery timing.
GET {{baseUrl}}/tasks/stream
Accept: application/json

> {%
    client.test("Stream endpoint returns 200", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(Array.isArray(response.body), "Response is an array");
        client.assert(response.body.length >= 2, "At least 2 tasks streamed");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 6. Command without response — Update
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Command (IRequest)] Update a task — no typed response
### Expect: success response
PUT {{baseUrl}}/tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Implement Synapse streaming (updated)",
  "description": "Updated description with more detail about the streaming feature"
}

> {%
    client.test("Update task succeeds", function () {
        client.assert(response.status < 400, "Expected success status code");
    });
%}

###

### Verify the update was applied
GET {{baseUrl}}/tasks/{{taskId}}
Accept: application/json

> {%
    client.test("Updated title is reflected", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.title === "Implement Synapse streaming (updated)", "Title updated");
    });
%}

###

### [Feature: Command failure] Update a non-existent task
PUT {{baseUrl}}/tasks/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Ghost task",
  "description": "This task does not exist"
}

> {%
    client.test("Update non-existent task returns error", function () {
        client.assert(response.status >= 400, "Expected an error status code");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 7. Events — domain event fan-out with concurrent orchestration
# ═══════════════════════════════════════════════════════════════════════

### [Feature: Events + ConcurrentEventOrchestrator] Complete a task
### Expect: success response
### Observe stdout: BOTH of the following run concurrently (ConcurrentEventOrchestrator):
###   - TaskCompletedLoggingHandler:      "✅ Task completed: ..."
###   - TaskCompletedNotificationHandler: "📧 Sending notification for ..."
### Also: SimpleLoggingBehavior logs CompleteTaskCommand timing
POST {{baseUrl}}/tasks/{{taskId}}/complete

> {%
    client.test("Complete task succeeds", function () {
        client.assert(response.status < 400, "Expected success status code");
    });
%}

###

### Verify status changed to Completed
GET {{baseUrl}}/tasks/{{taskId}}
Accept: application/json

> {%
    client.test("Task status is Completed", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.status === "Completed", "Status is Completed");
        client.assert(response.body.completedAt !== undefined, "completedAt is set");
    });
%}

###

### [Feature: Events] Delete the second task
### Observe stdout: TaskDeletedLoggingHandler logs "🗑️ Task deleted: ..."
DELETE {{baseUrl}}/tasks/{{taskId2}}

> {%
    client.test("Delete task succeeds", function () {
        client.assert(response.status < 400, "Expected success status code");
    });
%}

###

### Verify task 2 is gone
GET {{baseUrl}}/tasks/{{taskId2}}
Accept: application/json

> {%
    client.test("Deleted task is no longer found", function () {
        client.assert(response.status >= 400, "Expected an error status code");
    });
%}

###

# ═══════════════════════════════════════════════════════════════════════
# 8. Full workflow — Create → Update → Complete → Delete
# ═══════════════════════════════════════════════════════════════════════

### Step 1: Create
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Full workflow task",
  "description": "Demonstrates the complete Synapse lifecycle in one sequence"
}

> {%
    client.test("Workflow step 1 — create", function () {
        client.assert(response.status === 201, "Expected 201 Created");
        const location = response.headers.valueOf("Location");
        const guidPattern = /\/tasks\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i;
        client.global.set("wfTaskId", location.match(guidPattern)[1]);
    });
%}

###

### Step 2: Update
PUT {{baseUrl}}/tasks/{{wfTaskId}}
Content-Type: application/json

{
  "title": "Full workflow task (revised)",
  "description": "Now with an updated description"
}

> {%
    client.test("Workflow step 2 — update", function () {
        client.assert(response.status < 400, "Expected success");
    });
%}

###

### Step 3: Complete (triggers 2 concurrent event handlers)
POST {{baseUrl}}/tasks/{{wfTaskId}}/complete

> {%
    client.test("Workflow step 3 — complete", function () {
        client.assert(response.status < 400, "Expected success");
    });
%}

###

### Step 4: Delete
DELETE {{baseUrl}}/tasks/{{wfTaskId}}

> {%
    client.test("Workflow step 4 — delete", function () {
        client.assert(response.status < 400, "Expected success");
    });
%}

###

### Final: List should not contain the workflow task
GET {{baseUrl}}/tasks
Accept: application/json

> {%
    client.test("Workflow task no longer in list", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        const wfId = client.global.get("wfTaskId");
        const found = response.body.some(t => t.id === wfId);
        client.assert(!found, "Deleted task is not in the list");
    });
%}

###
