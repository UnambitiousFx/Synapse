<Project>
    <PropertyGroup>
        <Authors>Oleexo</Authors>
        <Product>UnambitiousFx</Product>
        <RootNamespace>$(Product).$(MSBuildProjectName)</RootNamespace>
        <AssemblyName>$(Product).$(MSBuildProjectName)</AssemblyName>
        <WarningsAsErrors>true</WarningsAsErrors>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Copyright>Copyright $([System.DateTime]::Now.Year) (c) UnambitiousFx. All rights reserved.</Copyright>
        <LibraryTargetFrameworks>net8.0;net9.0;net10.0</LibraryTargetFrameworks>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix Condition="'$(CI)' != 'true'">local.$([System.DateTime]::Now.ToString('yyyyMMddHHmm'))</VersionSuffix>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);NU5104</NoWarn>
    </PropertyGroup>
</Project>
