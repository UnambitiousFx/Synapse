<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>SynapseBenchmark</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="MediatR" />
        <PackageReference Include="Mediator.Abstractions" />
        <PackageReference Include="Mediator.SourceGenerator">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Synapse\Synapse.csproj" />
        <ProjectReference Include="..\..\src\Synapse.AspNetCore\Synapse.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Synapse.Endpoints\Synapse.Endpoints.csproj" />
        <!-- PrivateAssets="all" on the analyzer reference inside Synapse.Endpoints.csproj means the
             generator does not flow through this ProjectReference (the same constraint Task 20 hit).
             Without this explicit reference nothing generates GetThingEndpoint's partial, so its
             inherited abstract CreateMetadata is never overridden and the build fails on CS0534. -->
        <ProjectReference Include="..\..\src\Synapse.Endpoints.Generator\Synapse.Endpoints.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
