<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="unambitiousfx.myget.org" value="https://www.myget.org/F/unambitiousfx/api/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="unambitiousfx.myget.org">
            <package pattern="UnambitiousFx.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>