{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "reviewers": ["Oleexo"]
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.**"],
      "groupName": "microsoft"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet**"],
      "groupName": "benchmarkdotnet"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["xunit**", "NSubstitute**", "coverlet**"],
      "groupName": "testing"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["UnambitiousFx.**"],
      "groupName": "unambitiousfx"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["JetBrains.**"],
      "groupName": "jetbrains"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["System.**"],
      "groupName": "system"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.**", "Microsoft.AspNetCore.**", "Microsoft.EntityFrameworkCore**", "System.Security.Cryptography.Pkcs"],
      "matchCurrentVersion": "/^11\\./",
      "allowedVersions": "/^11\\./",
      "groupName": "microsoft net11"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.**", "Microsoft.AspNetCore.**", "Microsoft.EntityFrameworkCore**", "System.Security.Cryptography.Pkcs"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "/^10\\./",
      "groupName": "microsoft net10"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.**", "Microsoft.AspNetCore.**", "Microsoft.EntityFrameworkCore**", "System.Security.Cryptography.Pkcs"],
      "matchCurrentVersion": "/^9\\./",
      "allowedVersions": "/^9\\./",
      "groupName": "microsoft net9"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.**", "Microsoft.AspNetCore.**", "Microsoft.EntityFrameworkCore**", "System.Security.Cryptography.Pkcs"],
      "matchCurrentVersion": "/^8\\./",
      "allowedVersions": "/^8\\./",
      "groupName": "microsoft net8"
    }
  ]
}
