{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "Synapse.FluentValidation.csproj",
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "concurrency": 2,
    "reporters": ["html", "progress", "json"],
    "ignore-methods": [
      "Log*",
      "StartActivity",
      "SetTag",
      "SetStatus",
      "AddEvent"
    ],
    "ignore-mutations": ["string"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
