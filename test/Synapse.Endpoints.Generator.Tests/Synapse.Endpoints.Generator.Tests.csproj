<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Multi-targeted on purpose. The harness compiles generated code against the *running*
             process's platform assemblies, so each target framework verifies that the emitter's
             output compiles against that framework's ASP.NET Core and BCL surface. Pinning this to
             one TFM meant emitted binders were only ever compile-checked against one of the three
             the library ships for. -->
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Synapse.Abstractions\Synapse.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\Synapse.Endpoints\Synapse.Endpoints.csproj" />
        <ProjectReference Include="..\..\src\Synapse.Endpoints.Generator\Synapse.Endpoints.Generator.csproj" />
    </ItemGroup>

</Project>
